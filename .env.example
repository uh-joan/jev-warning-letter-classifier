# TypeSafe API key — Jev runs through the official @typesafe-ai/sdk (direct, not
# the Vercel gateway). Get one from https://console.typesafe.ai/settings/keys
TYPESAFE_AI_API_KEY=

# Optional: candidate proposer (--propose) runs a small LLM through the Vercel AI
# Gateway. Only needed if you use --propose; Jev itself does not use the gateway.
# AI_GATEWAY_API_KEY=
# JEV_PROPOSER_MODEL=google/gemini-2.5-flash

# Optional: openFDA API key (https://open.fda.gov/apis/authentication/). Raises rate
# limits for the drug lookup / labeler seeding in src/openfda.ts (--openfda).
# FDA_API_KEY=
