# Vercel AI Gateway key (routes to typesafe-ai/jev). Get one from the Vercel dashboard.
AI_GATEWAY_API_KEY=

# Optional: if you run the TypeSafe provider directly instead of the gateway,
# use @ai-sdk/typesafe-ai and set this instead.
# TYPESAFE_AI_API_KEY=

# Optional: openFDA API key (https://open.fda.gov/apis/authentication/). Raises rate limits
# for the drug lookup / labeler seeding in src/openfda.ts (--openfda).
# FDA_API_KEY=

# Optional: model for the candidate proposer (--propose). Must be one your gateway plan
# can call; the free tier allows e.g. google/gemini-2.5-flash, openai/gpt-4o-mini.
# JEV_PROPOSER_MODEL=google/gemini-2.5-flash

# Optional: Zero Data Retention on the gateway (Vercel Pro/Enterprise only).
# JEV_ZERO_DATA_RETENTION=1
