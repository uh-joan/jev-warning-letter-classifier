{
  "name": "classify-warning-letter",
  "version": "0.1.0",
  "description": "Classify FDA Warning Letters into structured regulatory data using TypeSafe's Jev (System One) model — selection over generation, so it never hallucinates a drug name.",
  "keywords": [
    "fda",
    "warning-letter",
    "pharma",
    "regulatory",
    "classifier",
    "typesafe",
    "jev",
    "cgmp",
    "nlp"
  ],
  "license": "MIT",
  "author": "Joan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uh-joan/jev-warning-letter-classifier.git"
  },
  "homepage": "https://github.com/uh-joan/jev-warning-letter-classifier#readme",
  "bugs": {
    "url": "https://github.com/uh-joan/jev-warning-letter-classifier/issues"
  },
  "type": "module",
  "bin": {
    "classify-warning-letter": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "run": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts fixtures/bausch-lomb-2026.txt",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "eval": "tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.105"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
